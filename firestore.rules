rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only you, signed in with your Google account, can read or write your planner.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // The widget's copy of your week. Readable by its long random code; only you can write it.
    match /feeds/{feedId} {
      allow get: if feedId.size() >= 20;
      allow create: if request.auth != null && feedId.size() >= 20
                    && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null && resource.data.owner == request.auth.uid
                    && request.resource.data.owner == request.auth.uid;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }
  }
}
